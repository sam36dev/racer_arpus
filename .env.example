# Credenciais do Firebase Admin (Console > Configuracoes do projeto > Contas de servico > Gerar nova chave privada)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Cole a private_key do JSON entre aspas, mantendo os \n literais
FIREBASE_PRIVATE_KEY=""

PORT=3000

# Autenticacao
JWT_SECRET=troque-por-uma-string-aleatoria-longa
# usernames (separados por virgula) com permissao de conceder conquistas manuais
ADMIN_USERNAMES=
